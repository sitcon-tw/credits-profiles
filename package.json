{
  "name": "sitcon-credits-profiles",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "test": "node scripts/ensure-pnpm.mjs && node scripts/docs/check-language.mjs && node --test scripts/profiles/*.test.mjs scripts/site-profiles/*.test.mjs",
    "docs:check": "node scripts/ensure-pnpm.mjs && node scripts/docs/check-language.mjs",
    "profiles:validate": "node scripts/ensure-pnpm.mjs && node scripts/profiles/validate.mjs",
    "site-profiles:validate": "node scripts/ensure-pnpm.mjs && node scripts/site-profiles/validate.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
